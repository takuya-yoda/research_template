\newcommand{\NT}[1]{\textcolor{magenta}{#1}}
\newcommand{\MD}[1]{\textcolor{blue}{#1}}
\newcommand{\PN}[1]{\textcolor{red}{#1}}
\newcommand{\NTmod}[1]{\textcolor[rgb]{0,0.7,0}{#1}}
\newcommand{\md}[1]{\textcolor{orange}{#1}}
