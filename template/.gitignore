# === PDF: 生成物・文献は追跡しない。図 (fig/ 配下) のみ追跡 ===
*.pdf
!**/fig/**/*.pdf
!**/fig/*.pdf

# === 文献 PDF 置場 (ローカル保管のみ) ===
survey/papers/*
!survey/papers/.gitkeep

# === 議論記録の写真 (git 管理外。NAS へ日次バックアップ: scripts/backup_to_nas.sh) ===
# PDF は全体ルール *.pdf で除外済み。メモ .md は追跡される
plan/discussions/**/*.jpg
plan/discussions/**/*.jpeg
plan/discussions/**/*.png
plan/discussions/**/*.heic

# === Python ===
.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# === Claude Code ===
# 共有する slash コマンド (.claude/commands/) は追跡し、個人の権限設定のみ除外する
.claude/settings.json
.claude/settings.local.json

# === OS ===
.DS_Store
